<Project Sdk="Microsoft.NET.Sdk">
  <!-- `fshw-lookup`: the pure-lookup verdict of a checkout (`FsHotWatch.Lookup.ofRepo`), with no
       daemon, no IPC and no FCS (AUTOMATION-1695, Phase 1 step C). Not a package: it is what
       experiment E5 times (scripts/e5-verdict-cost.sh), wall time and peak RSS, published Native
       AOT. It references FsHotWatch.Core ONLY, so a publish that needs anything else fails here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <AssemblyName>fshw-lookup</AssemblyName>
    <RootNamespace>FsHotWatch.Lookup</RootNamespace>
    <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No RuntimeFrameworkVersion / ILCompiler pin: the Native AOT toolchain and runtime packs
         follow the SDK band in global.json, whose runtime is past GHSA-p3jp-9v83-76w9 (Brotli,
         patched in 10.0.14). AUTOMATION-1708 moved the band and removed the bench-only pin. -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FsHotWatch.Core/FsHotWatch.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
