<Project>
    <PropertyGroup>
        <!-- One pin source for the whole repository (AUTOMATION-1367). A project opts out only by
             setting this false in its own body, which evaluates after this file: the restore-only
             tools/fsharplint-shim does, so transitive pinning cannot rewrite the analyzer bin it
             materializes. -->
        <ManagePackageVersionsCentrally Condition="'$(ManagePackageVersionsCentrally)' == ''">true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="FSharp.Analyzers.SDK" Version="0.39.2" />
        <!-- FSharp.Core is EXACT, never floated, and equal to the FSharp.Core the pinned FCS
             below requires (43.12.402 declares FSharp.Core [10.1.402]). A packed nuspec's
             floor is the version restore RESOLVED at pack time, so a float makes the floor
             whatever nuget.org had newest that day: TestPrune.Trace 0.7.5 was packed the day
             10.1.403 shipped, declared FSharp.Core >= 10.1.403, and every consumer pinned at
             [10.1.402] (FsHotWatch, and everything on it) failed restore with NU1605
             (AUTOMATION-1358). Raise it only together with FCS. Every packable project that
             compiles against FSharp.Core references it explicitly, so the floor is declared
             rather than inherited. scripts/check-package-floors.fsx (`mise run
             package-floors`, also in CI) fails when this floats or a packed floor exceeds it. -->
        <PackageVersion Include="FSharp.Core" Version="10.1.402" />
        <!-- FCS is EXACT, never floated: the fshw host supplies FCS to
             TestPrune.Analyzers at load time, and FCS's assembly version carries the patch
             (43.12.402.0), so an analyzer built against any other patch fails to load in the
             gate. Keep this equal to the FSharp.Compiler.Service in the pinned fshotwatch.cli's
             deps.json (.config/dotnet-tools.json) and move the two together;
             ToolchainPinTests fails when they diverge. -->
        <PackageVersion Include="FSharp.Compiler.Service" Version="43.12.402" />
        <PackageVersion Include="Ionide.ProjInfo" Version="0.74.2" />
        <PackageVersion Include="Ionide.ProjInfo.FCS" Version="0.74.2" />
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
        <!-- Transitive pin: the SQLitePCLRaw bundle pulls native lib.e_sqlite3 2.1.11,
             flagged High by GHSA-2m69-gcr7-jv3q. The native binary re-versions onto SQLite's
             own line (3.53.3) independently of the 2.1.x managed core/provider/bundle, and
             carries no managed dependencies, so pinning it forward fixes the advisory cleanly.
             CentralPackageTransitivePinningEnabled makes this PackageVersion a real dependency
             of the published TestPrune.Core, so consumers inherit the floor and do not need a
             pin of their own — FsHotWatch carried duplicates of this one until 2026-08-11. -->
        <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
        <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
        <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
        <!-- RefStamp: inert build-time guard that stamps a ref onto local packs so
             fsprojlint's "local packs are ref-stamped" check is satisfied. PrivateAssets=all
             keeps it out of published package dependencies. -->
        <PackageVersion Include="RefStamp" Version="0.1.0-alpha.4" />
        <PackageVersion Include="Unquote" Version="7.0.1" />
        <PackageVersion Include="xunit.v3" Version="4.0.0" />
        <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.0" />

        <!-- The FsHotWatch engine, plugins, tests and tools (inline versions until AUTOMATION-1367). -->
        <PackageVersion Include="CommandTree" Version="0.14.1" />
        <PackageVersion Include="CoverageRatchet.Core" Version="0.1.0-alpha.13" />
        <PackageVersion Include="FSharp.Data.Adaptive" Version="1.2.26" />
        <!-- FsHotWatch.Lint only (unused by every consumer; retired with it). The gate's own
             FSharpLint analyzer is tools/fsharplint-shim, which pins its version outside CPM. -->
        <PackageVersion Include="FSharpLintAnalyzerShim" Version="0.5.0-alpha.1" />
        <PackageVersion Include="FsCheck" Version="3.3.2" />
        <PackageVersion Include="G-Research.FSharp.Analyzers" Version="0.25.0" />
        <PackageVersion Include="Ignore" Version="0.2.1" />
        <PackageVersion Include="MessagePack" Version="2.5.303" />
        <PackageVersion Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.607501" />
        <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.21" />
        <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.3.3" />
        <PackageVersion Include="StreamJsonRpc" Version="2.25.29" />
        <!-- Transitive security pins (CentralPackageTransitivePinningEnabled applies them wherever
             the packages arrive, which is via FCS / FSharpLint).
             System.Security.Cryptography.Xml 9.0.0 had GHSA-w3x6-4m5h-cxqf / GHSA-37gx-xxp4-5rgx;
             10.0.9 then GHSA-8q5v-6pqq-x66h / GHSA-23rf-6693-g89p / -cvvh / -g8r8 / -mmjf (patched
             in 10.0.10); 10.0.11 and its System.Security.Cryptography.Pkcs then
             GHSA-7hqp-7c5m-4vq6 / -c399-9853-6jmj / -r955-8q5j-3h83 (Xml) and
             GHSA-2fmv-rv2c-59x7 / -846f-f764-76mx (Pkcs), all patched in 10.0.13. -->
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
        <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    </ItemGroup>
</Project>
