<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- FSHW-WALL-001 on its own, apart from FsHotWatch.Rules, so `.fshw.json` can
         scope it on its own: the wall-clock ban covers every test source in the
         repository, TestPrune's included, while the other house rules stay scoped
         to FsHotWatch's code (AUTOMATION-1364). Never published. -->
    <IsPackable>false</IsPackable>
    <!-- LOAD-BEARING: FSharp.Analyzers.SDK only opens `*Analyzer*.dll`; see
         FsHotWatch.Rules.fsproj. -->
    <AssemblyName>FsHotWatch.WallClockAnalyzers</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../FsHotWatch.Rules/TestSource.fs" Link="TestSource.fs" />
    <Compile Include="WallClockAnalyzer.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FSharp.Analyzers.SDK" />
    <PackageReference Include="FSharp.Compiler.Service" />
  </ItemGroup>
</Project>
