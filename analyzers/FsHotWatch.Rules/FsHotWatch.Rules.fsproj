<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Repo-local convention rules, loaded by the gate via `.fshw.json`
         `analyzers.paths`. Never published: these are FsHotWatch's own house
         rules, not something to impose on package consumers. -->
    <IsPackable>false</IsPackable>
    <!-- LOAD-BEARING: FSharp.Analyzers.SDK's loader only opens assemblies whose
         FILENAME matches `*Analyzer*.dll` (see Client.LoadAnalyzers). A DLL
         without "Analyzer" in its name is never scanned — it loads ZERO
         analyzers, silently, and the gate would run without the house rules
         while still reporting green. (fshw's own fail-loud guard turns that
         into `config error: Analyzer path(s) loaded 0 analyzers`, and the
         positive-control integration tests assert LoadedCount >= 1 — both
         caught this rename requirement.) -->
    <AssemblyName>FsHotWatch.ConventionAnalyzers</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ConventionAnalyzers.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.*" />
    <PackageReference Include="FSharp.Analyzers.SDK" Version="0.37.2" />
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.204" />
  </ItemGroup>
</Project>
