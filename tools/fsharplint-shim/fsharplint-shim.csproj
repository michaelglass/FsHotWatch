<Project Sdk="Microsoft.Build.NoTargets/3.7.0">
  <!--
    Restore-only project: pulls FSharpLintAnalyzerShim + its bundled deps into
    bin/<Configuration>/net10.0/ so fshw's AnalyzersPlugin can load them via a
    directory path. Microsoft.Build.NoTargets skips Csc entirely so we don't
    generate an empty fsharplint-shim.dll on every build.

    IMPORTANT: the analyzers path in .fshw.json MUST match the configuration the
    build uses. CI (the reusable michaels-wacky-build workflow) and the daemon
    both build Debug (`dotnet build`), so .fshw.json points at bin/Debug/net10.0/.
    Pointing it at a config CI doesn't build makes the AnalyzersPlugin load ZERO
    analyzers and the lint silently passes — which is exactly the bug this comment
    exists to prevent.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!-- NU1605 (version downgrade) is expected: the shim pins FCS 43.12.x
         while FSharp.Analyzers.SDK transitively asks for an older FCS. -->
    <NoWarn>$(NoWarn);NU1605</NoWarn>
    <!-- NU1603 (requested version not found, a HIGHER one substituted) is an error
         here, not NuGet's default warning: the pin above decides which FSharpLint
         findings the check produces (.fshw.json hashes this project for exactly that
         reason), and a restore that silently swaps in another version is a different
         analyzer wearing the same path. Fail the build by name instead. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1603</WarningsAsErrors>
    <!-- Outside Central Package Management: transitive pinning would rewrite the FCS and
         FSharp.Core this restore materializes into the analyzer bin (the shim declares FCS
         43.12.400), changing the analyzer without changing its pin. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharpLintAnalyzerShim" Version="0.6.0-alpha.1" />
    <!-- The security pins Directory.Packages.props applies to every CPM project (see there). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
