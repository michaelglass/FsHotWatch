<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The example IS the API contract demo, so it is held to src/'s bar: a new
         DU case or a changed signature must break THIS build, loudly. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PluginExample.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <ProjectReference Include="../../src/FsHotWatch/FsHotWatch.fsproj" />
    <!-- FsHotWatch.Core, which FsHotWatch references privately (AUTOMATION-1695). -->
    <ProjectReference Include="../../src/FsHotWatch.Core/FsHotWatch.Core.fsproj" />
  </ItemGroup>
</Project>
