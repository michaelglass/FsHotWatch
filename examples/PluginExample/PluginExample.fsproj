<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The example IS the API contract demo, so it is held to src/'s bar: a new
         DU case or a changed signature must break THIS build, loudly. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PluginExample.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.*" />
    <ProjectReference Include="../../src/FsHotWatch/FsHotWatch.fsproj" />
  </ItemGroup>
</Project>
