<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The example IS the API contract demo, so it is held to src/'s bar: a new
         DU case or a changed signature must break THIS build, loudly. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="WildcardAnalyzer.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FSharp.Analyzers.SDK" />
    <PackageReference Include="FSharp.Compiler.Service" />
  </ItemGroup>
</Project>
