<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);NU1605;NU1608;MSB3277;NETSDK1188</NoWarn>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Coverage is scoped to the TestPrune.Trace* modules by testconfig.json (MTP copies it next to
    the test app as TestPrune.Trace.Tests.testconfig.json). These tests load TestPrune.Core, whose
    files are measured, and ratcheted, by TestPrune.Tests; without the scope they would appear
    here too, at this project's 100% default. It is a per-project setting because CI's reusable
    workflow passes no coverage-settings file; `mise run test` skips the shared one here, as MTP
    refuses a run given both.
  -->
  <ItemGroup>
    <Compile Include="QuotationWarmup.fs" />
    <Compile Include="Fixtures.fs" />
    <Compile Include="ScaffoldTests.fs" />
    <Compile Include="RecorderStateTests.fs" />
    <Compile Include="XunitContextTests.fs" />
    <Compile Include="DumpRoundTripTests.fs" />
    <Compile Include="RuntimeTests.fs" />
    <Compile Include="TraceStoreTests.fs" />
    <Compile Include="FingerprintTests.fs" />
    <Compile Include="ManifestTests.fs" />
    <Compile Include="LaunchTests.fs" />
    <Compile Include="WeaverTests.fs" />
    <Compile Include="WeaverShapeTests.fs" />
    <Compile Include="SiteProbeScenarioTests.fs" />
    <Compile Include="SiteProbeShapeTests.fs" />
    <Compile Include="InputCaptureTests.fs" />
    <Compile Include="FixtureIndex.fs" />
    <Compile Include="JoinerTests.fs" />
    <Compile Include="ShadowBinTests.fs" />
    <Compile Include="TraceIngestTests.fs" />
    <Compile Include="CensusTests.fs" />
    <Compile Include="CensusCliTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TestPrune.Trace/TestPrune.Trace.fsproj" />
    <ProjectReference Include="../../src/TestPrune.Trace.Recorder/TestPrune.Trace.Recorder.fsproj" />
    <ProjectReference Include="../../src/TestPrune.Trace.Cli/TestPrune.Trace.Cli.fsproj" />
    <!-- The real indexer, for the joiner's fixture index. -->
    <ProjectReference Include="../../src/TestPrune/TestPrune.fsproj" />
    <!-- Build order only: the fixtures must be built before these tests read them. -->
    <ProjectReference Include="../TraceFixtures/src/FxDriver/FxDriver.fsproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../TraceFixtures/tests/FxTests/FxTests.fsproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Unquote" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

</Project>
