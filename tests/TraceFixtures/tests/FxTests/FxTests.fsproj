<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <NoWarn>$(NoWarn);NU1605;NU1608</NoWarn>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="AttributionTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/FxLib/FxLib.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3.mtp-v2" />
        <!-- Central package management turns off the SDK's implicit FSharp.Core reference; without
             this the app lists FSharp.Core in its deps.json but ships no FSharp.Core.dll and cannot start. -->
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>

</Project>
