    <PackageDownload Include="FSharp.Core" Version="[10.1.400]" />
    <PackageDownload Include="FSharp.Data.Adaptive" Version="[1.2.26]" />
    <PackageDownload Include="FSharpLint.Core" Version="[0.27.0]" />
    <PackageDownload Include="FSharpx.Collections" Version="[3.1.0]" />
    <PackageDownload Include="Ignore" Version="[0.2.1]" />
    <PackageDownload Include="Ionide.ProjInfo" Version="[0.74.2]" />
