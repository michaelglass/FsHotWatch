<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Test-only restore manifest for the exact package paths recorded in the
       FsHot FCS capture. PackageDownload keeps these out of TestPrune's compile
       graph while making the always-on replay reproducible in a clean checkout. -->
