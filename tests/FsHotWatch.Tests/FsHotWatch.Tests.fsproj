<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- FS0988: existing suppression; FS3511: state machine not statically compilable; NETSDK1188: harmless locale warnings from Microsoft.Testing.Platform -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- First: registers the xUnit pipeline startup that initialises FSharp.Core's
         quotation statics on one thread before tests run in parallel. See the file. -->
    <Compile Include="QuotationStaticInit.fs" />
    <Compile Include="TestHelpers.fs" />
    <!-- After TestHelpers (uses withTempDir + probeLoop), before every test file
         that watches a directory. -->
    <Compile Include="WatchedDir.fs" />
    <Compile Include="TestHelpersTests.fs" />
    <Compile Include="ImpactDbPoolTests.fs" />
    <!-- RepoTasks and AnalyzerFixtures read the repository itself (mise.toml, the
         built house-rules analyzer); BCL-only, so they sit before every test file
         that relocates an analyzer into a temp checkout. -->
    <Compile Include="RepoTasks.fs" />
    <Compile Include="AnalyzerFixtures.fs" />
    <Compile Include="StringHelpersTests.fs" />
    <Compile Include="ProjectModelTests.fs" />
    <Compile Include="ProcessHelperTests.fs" />
    <Compile Include="ProcessOwnershipTests.fs" />
    <Compile Include="RunLogTests.fs" />
    <Compile Include="OperationWatchdogTests.fs" />
    <Compile Include="WaitWedgeTests.fs" />
    <Compile Include="RunStatusHandoffTests.fs" />
    <Compile Include="LifecycleTests.fs" />
    <Compile Include="ErrorLedgerTests.fs" />
    <Compile Include="FileErrorReporterTests.fs" />
    <Compile Include="EventTests.fs" />
    <Compile Include="CachePathIdentityTests.fs" />
    <Compile Include="CrossWorkspaceCacheTests.fs" />
    <Compile Include="AnalyzerCacheKeyTests.fs" />
    <Compile Include="CheckCacheTests.fs" />
    <Compile Include="CacheInputsTests.fs" />
    <Compile Include="StructureFilesTests.fs" />
    <Compile Include="PluginTests.fs" />
    <Compile Include="TaskCacheTests.fs" />
    <Compile Include="PluginWorkOwnerTests.fs" />
    <Compile Include="SupervisedWorkTests.fs" />
    <Compile Include="DebouncedWorkTests.fs" />
    <Compile Include="AdmissionBoundTests.fs" />
    <Compile Include="PluginFrameworkTests.fs" />
    <Compile Include="PluginFrameworkFixtures.fs" />
    <Compile Include="PluginFrameworkOwnershipTests.fs" />
    <Compile Include="PluginFrameworkRunOwnershipTests.fs" />
    <Compile Include="PluginFrameworkLeaseTests.fs" />
    <Compile Include="PluginCtxHelpersTests.fs" />
    <Compile Include="PluginHostTests.fs" />
    <Compile Include="PluginActivityTests.fs" />
    <Compile Include="PluginHostActivityTests.fs" />
    <Compile Include="MacFsEventsTests.fs" />
    <Compile Include="WatcherTests.fs" />
    <Compile Include="SharedWatchPoolTests.fs" />
    <Compile Include="SessionScopeTests.fs" />
    <Compile Include="DaemonTests.fs" />
    <Compile Include="DaemonHostingTests.fs" />
    <Compile Include="CheckerPartitionsTests.fs" />
    <Compile Include="PathFrameTests.fs" />
    <Compile Include="CanonicalProjectsTests.fs" />
    <Compile Include="FrameExclusionsTests.fs" />
    <Compile Include="SessionFramesTests.fs" />
    <Compile Include="HostingSeamTests.fs" />
    <Compile Include="SessionRegistryTests.fs" />
    <Compile Include="RepositoryIpcTests.fs" />
    <Compile Include="RepositoryHostTests.fs" />
    <Compile Include="RepositoryHostModeTests.fs" />
    <Compile Include="RepositoryHostIsolationTests.fs" />
    <Compile Include="RepositoryHostSharingTests.fs" />
    <Compile Include="RepositoryHostParityTests.fs" />
    <Compile Include="ScanActivityTests.fs" />
    <Compile Include="DaemonPhasesTests.fs" />
    <Compile Include="ScanMetricsTests.fs" />
    <Compile Include="IdleExitTests.fs" />
    <Compile Include="HeartbeatTests.fs" />
    <Compile Include="DaemonIdentityTests.fs" />
    <Compile Include="RepositoryIdentityTests.fs" />
    <Compile Include="AttachHandshakeTests.fs" />
    <Compile Include="WatchRouterTests.fs" />
    <Compile Include="PluginWedgeTests.fs" />
    <Compile Include="ProcessReapingTests.fs" />
    <Compile Include="IpcTests.fs" />
    <Compile Include="ServeOrderingTests.fs" />
    <Compile Include="RunHookScopeTests.fs" />
    <Compile Include="DaemonProcessScopeTests.fs" />
    <Compile Include="HostedRpcScopeTests.fs" />
    <Compile Include="IpcPayloadTests.fs" />
    <!-- The TestPrune plugin suite, split across four files so no single one exceeds
         TestPrune's 32,768-node symbol-traversal budget (past it a file gets no symbol
         analysis at all). The support module holds the harness helpers the parts share
         and MUST stay first: F# is order-dependent. -->
    <Compile Include="TestPrunePluginTestSupport.fs" />
    <Compile Include="TestPrunePluginTests.fs" />
    <Compile Include="TestPruneFreshnessGateTests.fs" />
    <Compile Include="TestPrunePendingVerificationTests.fs" />
    <Compile Include="TestPruneRunScopeTests.fs" />
    <Compile Include="TestPruneOwnerStateTests.fs" />
    <Compile Include="AnalysisEvidenceTests.fs" />
    <Compile Include="VerdictEvidenceTests.fs" />
    <Compile Include="TestPruneCheckReachSeamTests.fs" />
    <Compile Include="TestPruneSelectionSoundnessTests.fs" />
    <Compile Include="TestPruneRunnerFamilyTests.fs" />
    <Compile Include="TestPruneRatchetTransactionTests.fs" />
    <Compile Include="TestPruneSignatureOccurrenceTests.fs" />
    <Compile Include="TestPruneDebtScopeTests.fs" />
    <Compile Include="TestPruneImpactQueryCountTests.fs" />
    <Compile Include="TestPruneConfirmPassThroughTests.fs" />
    <Compile Include="TestModeSeamTests.fs" />
    <Compile Include="StaleArtifactPreflightTests.fs" />
    <Compile Include="DependencyFanoutTests.fs" />
    <Compile Include="FileFreshnessTests.fs" />
    <Compile Include="DeletedFileFreshnessTests.fs" />
    <Compile Include="NewFileSelectionTests.fs" />
    <Compile Include="FlakinessTests.fs" />
    <Compile Include="AnalyzersPluginTests.fs" />
    <Compile Include="LintPluginTests.fs" />
    <Compile Include="FantomasToolTests.fs" />
    <Compile Include="FormatCheckPluginTests.fs" />
    <Compile Include="FormatIgnoreTests.fs" />
    <Compile Include="CommandPreprocessorTests.fs" />
    <Compile Include="PathFilterTests.fs" />
    <Compile Include="SafeWalkTests.fs" />
    <Compile Include="ProjectGraphTests.fs" />
    <Compile Include="OutputCopyFreshnessTests.fs" />
    <Compile Include="DepsFreshnessTests.fs" />
    <Compile Include="CheckPipelineTests.fs" />
    <Compile Include="FcsCacheProbe.fs" />
    <Compile Include="SnapshotVersionTests.fs" />
    <Compile Include="CheckCacheReferencedOutputTests.fs" />
    <Compile Include="SolutionScopeTests.fs" />
    <Compile Include="DaemonConfigTests.fs" />
    <Compile Include="InitConfigTests.fs" />
    <Compile Include="RunOnceOutputTests.fs" />
    <Compile Include="IpcParsingTests.fs" />
    <Compile Include="CheckVerdictTests.fs" />
    <Compile Include="RunClaimTests.fs" />
    <Compile Include="VerdictTests.fs" />
    <Compile Include="IpcOutputTests.fs" />
    <Compile Include="ProgressRendererTests.fs" />
    <Compile Include="ActivityIntegrationTests.fs" />
    <Compile Include="SourceRefTests.fs" />
    <Compile Include="CliTests.fs" />
    <Compile Include="DeadCodeTests.fs" />
    <Compile Include="ProgramTests.fs" />
    <Compile Include="DetachedLaunchTests.fs" />
    <Compile Include="LauncherLifetimeTests.fs" />
    <Compile Include="LoadedConfigIdentityTests.fs" />
    <Compile Include="AnalyzerPathDiagnosisTests.fs" />
    <Compile Include="BuildDiagnosticTests.fs" />
    <Compile Include="BuildPluginTests.fs" />
    <Compile Include="BuildOverrunTests.fs" />
    <Compile Include="FileCommandPluginTests.fs" />
    <Compile Include="RunLevelHookGapTests.fs" />
    <Compile Include="ReleaseOrchestrationTests.fs" />
    <Compile Include="AnalyzerMaterializationTests.fs" />
    <Compile Include="GatePurityTests.fs" />
    <Compile Include="BenchmarkPlacementTests.fs" />
    <Compile Include="AnalyzerIdentityTests.fs" />
    <Compile Include="NuGetPublicationBarrierTests.fs" />
    <Compile Include="CoveragePluginTests.fs" />
    <Compile Include="LoggingTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build the real xUnit 4 runner fixture
         compatibility test invokes it without rebuilding. Its assemblies and package
         graph do not flow into this xUnit 3 test host. -->
    <ProjectReference Include="../Fixtures/Xunit4RunnerFixture/Xunit4RunnerFixture.fsproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/FsHotWatch.Cli/FsHotWatch.Cli.fsproj" />
    <ProjectReference Include="../../src/FsHotWatch/FsHotWatch.fsproj" />
    <ProjectReference Include="../../src/FsHotWatch.TestPrune/FsHotWatch.TestPrune.fsproj" />
    <ProjectReference Include="../../src/FsHotWatch.Analyzers/FsHotWatch.Analyzers.fsproj" />
    <ProjectReference Include="../../src/FsHotWatch.Lint/FsHotWatch.Lint.fsproj" />
    <ProjectReference Include="../../src/FsHotWatch.Fantomas/FsHotWatch.Fantomas.fsproj" />
    <ProjectReference Include="../../src/FsHotWatch.Build/FsHotWatch.Build.fsproj" />
    <ProjectReference Include="../../src/FsHotWatch.FileCommand/FsHotWatch.FileCommand.fsproj" />
    <ProjectReference Include="../../src/FsHotWatch.Coverage/FsHotWatch.Coverage.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.*" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0" />
    <PackageReference Include="Unquote" Version="7.0.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.9.0" />
    <PackageReference Include="G-Research.FSharp.Analyzers" Version="0.23.0" />
  </ItemGroup>
</Project>
