<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Exclude>
        <ModulePath>.*Tests\.dll$</ModulePath>
        <ModulePath>.*ExampleAnalyzer\.dll$</ModulePath>
        <ModulePath>.*xunit.*</ModulePath>
        <ModulePath>.*Unquote.*</ModulePath>
        <!-- External TestPrune packages. Their sources show up in cobertura with
             0% coverage from this side; exclude so the ratchet doesn't gate on
             dependencies. FsHotWatch.TestPrune.dll (our plugin) is NOT matched. -->
        <ModulePath>.*[/\\]TestPrune\.Core\.dll$</ModulePath>
        <ModulePath>.*[/\\]TestPrune\.Falco\.dll$</ModulePath>
        <ModulePath>.*[/\\]TestPrune\.Sql\.dll$</ModulePath>
        <ModulePath>.*[/\\]TestPrune\.SqlHydra\.dll$</ModulePath>
        <!-- CoverageRatchet.Core is release tooling, not first-party FsHotWatch
             code. Exclude its portable-PDB sources from this repository's floors. -->
        <ModulePath>.*[/\\]CoverageRatchet\.Core\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
