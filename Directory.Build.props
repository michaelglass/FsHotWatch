<Project>
  <PropertyGroup>
    <!-- Disable SourceLink when no .git directory exists (jj without colocated git) -->
    <EnableSourceLink Condition="!Exists('$(MSBuildThisFileDirectory).git')">false</EnableSourceLink>
    <EnableSourceControlManagerQueries Condition="!Exists('$(MSBuildThisFileDirectory).git')">false</EnableSourceControlManagerQueries>

    <!-- NU1608: FSharp.Analyzers.SDK 0.37.2 pins old FCS/FSharp.Core; we use newer. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <!-- Pin transitive System.Security.Cryptography.Xml to a patched version
       (9.0.0 has CVEs GHSA-w3x6-4m5h-cxqf and GHSA-37gx-xxp4-5rgx). Applied
       repo-wide because multiple plugin projects pull it in via FCS/FSharpLint. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.9" />
  </ItemGroup>
  <!-- Pin transitive Nerdbank.MessagePack to a patched version (1.0.2 has
       GHSA-2cwq-pwfr-wcw3 — attacker-controlled stackalloc in DateTime
       decoding causes process-terminating StackOverflowException; patched
       in 1.1.62, kept current at 1.2.4). Pulled in via StreamJsonRpc. -->
  <ItemGroup>
    <PackageReference Include="Nerdbank.MessagePack" Version="1.2.4" />
  </ItemGroup>
</Project>
