<Project>
  <PropertyGroup>
    <!-- Disable SourceLink when no .git directory exists (jj without colocated git) -->
    <EnableSourceLink Condition="!Exists('$(MSBuildThisFileDirectory).git')">false</EnableSourceLink>
    <EnableSourceControlManagerQueries Condition="!Exists('$(MSBuildThisFileDirectory).git')">false</EnableSourceControlManagerQueries>

    <!-- NU1608: FSharp.Analyzers.SDK 0.37.2 pins old FCS/FSharp.Core; we use newer. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <!-- Pin transitive System.Security.Cryptography.Xml to a patched version.
       9.0.0 had GHSA-w3x6-4m5h-cxqf / GHSA-37gx-xxp4-5rgx; then 10.0.9 itself
       became affected by GHSA-8q5v-6pqq-x66h / GHSA-23rf-6693-g89p / -cvvh /
       -g8r8 / -mmjf (high severity, patched in 10.0.10). Applied repo-wide
       because multiple plugin projects pull it in via FCS/FSharpLint. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

  <!-- RefStamp: embeds the source ref (change-id.commit-id[.dirty]) into the
       package version at pack time, so a local pack advertises exactly which
       tree it was built from. Applied repo-wide so every packable project is
       ref-stamped (satisfies fsprojlint's "local packs are ref-stamped"
       check). PrivateAssets="all" — build/test-time only, never flows to
       consumers and inert during ordinary build/test. -->
  <ItemGroup>
    <PackageReference Include="RefStamp" Version="0.1.0-alpha.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
