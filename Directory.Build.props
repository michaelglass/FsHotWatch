<Project>
  <PropertyGroup>
    <!-- Disable SourceLink when no .git directory exists (jj without colocated git) -->
    <EnableSourceLink Condition="!Exists('$(MSBuildThisFileDirectory).git')">false</EnableSourceLink>
    <EnableSourceControlManagerQueries Condition="!Exists('$(MSBuildThisFileDirectory).git')">false</EnableSourceControlManagerQueries>

    <!-- NU1608: FSharp.Analyzers.SDK pins exact FCS/FSharp.Core versions that differ from the exact pins here (FCS 43.12.402, FSharp.Core 10.1.402 in Directory.Packages.props; ToolchainPinTests). -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <!-- Package versions live in Directory.Packages.props (Central Package Management), including
       the transitive System.Security.Cryptography.* security pins this file used to carry as
       direct references. -->

  <!-- RefStamp: embeds the source ref (change-id.commit-id[.dirty]) into the
       package version at pack time, so a local pack advertises exactly which
       tree it was built from. Applied repo-wide so every packable project is
       ref-stamped (satisfies fsprojlint's "local packs are ref-stamped"
       check). PrivateAssets="all" — build/test-time only, never flows to
       consumers and inert during ordinary build/test. Not on a project that opts out of CPM
       (tools/fsharplint-shim, restore-only and never packed): it would have no version. -->
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="RefStamp" PrivateAssets="all" />
  </ItemGroup>
</Project>
