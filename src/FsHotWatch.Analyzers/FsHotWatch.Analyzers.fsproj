<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package metadata -->
    <PackageId>FsHotWatch.Analyzers</PackageId>
    <Version>0.7.0-alpha.57</Version>
    <Authors>Michael Glass</Authors>
    <Description>FsHotWatch plugin for F# Analyzers SDK integration</Description>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/michaelglass/FsHotWatch</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/michaelglass/FsHotWatch</PackageProjectUrl>
    <PackageTags>fsharp;analyzers;fsharp-analyzers-sdk;static-analysis;plugin</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AnalyzerIdentity.fs" />
    <Compile Include="AnalyzerLoad.fs" />
    <Compile Include="AnalyzerFindings.fs" />
    <Compile Include="AnalyzerReplies.fs" />
    <Compile Include="AnalyzeRecords.fs" />
    <Compile Include="AnalyzeNeeds.fs" />
    <Compile Include="AnalyzersPlugin.fs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FsHotWatch.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FsHotWatch/FsHotWatch.fsproj" />
    <!-- FsHotWatch.Core is not a package (AUTOMATION-1668). PrivateAssets keeps it out of
         this nupkg's dependencies; `PackFsHotWatchCore` below carries its assembly in lib/. -->
    <ProjectReference Include="../FsHotWatch.Core/FsHotWatch.Core.fsproj" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackFsHotWatchCore</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <!-- Packs FsHotWatch.Core's built assembly beside this one, in lib/. It asks Core for its output
       path (GetTargetPath builds nothing) instead of resolving references, which would build and
       breaks a no-build pack with NETSDK1085 (the package-floor check in mise run ci). -->
  <Target Name="PackFsHotWatchCore">
    <MSBuild Projects="../FsHotWatch.Core/FsHotWatch.Core.fsproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_FsHotWatchCoreAssembly" />
    </MSBuild>
    <ItemGroup>
      <BuildOutputInPackage Include="@(_FsHotWatchCoreAssembly)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FSharp.Analyzers.SDK" />
    <PackageReference Include="FSharp.Compiler.Service" />
  </ItemGroup>
</Project>
