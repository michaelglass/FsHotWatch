<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package metadata -->
    <PackageId>FsHotWatch.Analyzers</PackageId>
    <Version>0.7.0-alpha.57</Version>
    <Authors>Michael Glass</Authors>
    <Description>FsHotWatch plugin for F# Analyzers SDK integration</Description>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/michaelglass/FsHotWatch</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/michaelglass/FsHotWatch</PackageProjectUrl>
    <PackageTags>fsharp;analyzers;fsharp-analyzers-sdk;static-analysis;plugin</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AnalyzerIdentity.fs" />
    <Compile Include="AnalyzerLoad.fs" />
    <Compile Include="AnalyzerFindings.fs" />
    <Compile Include="AnalyzerReplies.fs" />
    <Compile Include="AnalyzeRecords.fs" />
    <Compile Include="AnalyzeNeeds.fs" />
    <Compile Include="AnalyzersPlugin.fs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FsHotWatch.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FsHotWatch/FsHotWatch.fsproj" />
    <!-- FsHotWatch.Core is not a package (AUTOMATION-1668). PrivateAssets keeps it out of
         this nupkg's dependencies; its assembly ships in the FsHotWatch package's lib/, which
         this one depends on. -->
    <ProjectReference Include="../FsHotWatch.Core/FsHotWatch.Core.fsproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FSharp.Analyzers.SDK" />
    <PackageReference Include="FSharp.Compiler.Service" />
  </ItemGroup>
</Project>
