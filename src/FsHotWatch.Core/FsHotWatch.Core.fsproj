<Project Sdk="Microsoft.NET.Sdk">
  <!-- FsHotWatch.Core (AUTOMATION-1635): the re-architecture's pure foundation types. Its
       rules hold from day one, because each is cheap to keep and expensive to restore:
       - NO FSharp.Compiler.Service, NO MSBuild, NO xUnit. Only FSharp.Core and `Ignore` (below).
       - NO `%A` and no reflection-based serialisation. `reflectionfree` below makes the
         compiler refuse `%A` and stop generating the `%+A` ToString on records/unions,
         so a type that wants text writes it.
       - IsTrimmable/IsAotCompatible are kept as package metadata for consumers who trim,
         but the trim/AOT analyzers do NOT run for F# (they are Roslyn analyzers; a
         reflection probe built clean). the `reflectionfree` compiler flag below is the enforcement. An
         AOT-publish smoke check is deferred to experiment E5. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
    <!-- Never its own package (AUTOMATION-1668: one library, with a CLI). A packed project
         that uses it carries FsHotWatch.Core.dll inside its own nupkg: the FsHotWatch
         package does, and every other package depends on it. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Digests.fs" />
    <Compile Include="RepoRelativePath.fs" />
    <Compile Include="Questions.fs" />
    <Compile Include="RecordKind.fs" />
    <Compile Include="VerdictAndPurity.fs" />
    <Compile Include="KindedOutcome.fs" />
    <Compile Include="Need.fs" />
    <!-- The legacy string-keyed core, moved here unchanged under its own module names (AUTOMATION-1695).
         LAST, so nothing in namespace FsHotWatch.Core can resolve a name to them by accident. -->
    <Compile Include="LegacyActionKey.fs" />
    <Compile Include="LookupVerdict.fs" />
    <Compile Include="Requirements.fs" />
    <Compile Include="RequiredConfig.fs" />
    <Compile Include="OutcomeRecords.fs" />
    <!-- The tree walk and hash (AUTOMATION-1695, Phase 1 step C), moved unchanged under their own
         module names, so a pure-lookup verdict runs on this assembly alone (experiment E5). -->
    <Compile Include="Locking.fs" />
    <Compile Include="Logging.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="ContentHash.fs" />
    <Compile Include="FsHwPaths.fs" />
    <Compile Include="SafeWalk.fs" />
    <Compile Include="PathFilter.fs" />
    <Compile Include="Discovery.fs" />
    <Compile Include="VerdictInputs.fs" />
    <Compile Include="ConfiguredTestRoots.fs" />
    <Compile Include="TreeHash.fs" />
    <!-- The outcome store and where it lives (AUTOMATION-1695, Phase 1 step C): the disk backend of
         `IOutcomeStore`, with the repository identity that names its directory. -->
    <Compile Include="MacAttrList.fs" />
    <Compile Include="StoredName.fs" />
    <Compile Include="RepositoryIdentity.fs" />
    <Compile Include="RepoIdentity.fs" />
    <Compile Include="OutcomeStore.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <!-- The ONE permitted dependency besides FSharp.Core (decided 2026-11-14, AUTOMATION-1695): gitignore
         matching for the tree walk (PathFilter, VerdictInputs). Pure .NET; E5's AOT publish must show it
         trims with zero warnings. CoreBoundaryTests holds the exact allowlist. -->
    <PackageReference Include="Ignore" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same assemblies FsHotWatch lets see its internals, and FsHotWatch itself: `Locking` and
         `Discovery` are internal and moved here with the tree walk. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo"><_Parameter1>FsHotWatch</_Parameter1></AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo"><_Parameter1>FsHotWatch.Tests</_Parameter1></AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo"><_Parameter1>FsHotWatch.IntegrationTests</_Parameter1></AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo"><_Parameter1>FsHotWatch.Cli</_Parameter1></AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo"><_Parameter1>FsHotWatch.TestPrune</_Parameter1></AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo"><_Parameter1>FsHotWatch.Build</_Parameter1></AssemblyAttribute>
  </ItemGroup>
</Project>
