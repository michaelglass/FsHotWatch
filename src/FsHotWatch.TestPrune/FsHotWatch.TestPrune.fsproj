<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package metadata -->
    <PackageId>FsHotWatch.TestPrune</PackageId>
    <Version>0.13.0-alpha.98</Version>
    <Authors>Michael Glass</Authors>
    <Description>FsHotWatch plugin for TestPrune test impact analysis</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/michaelglass/FsHotWatch</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/michaelglass/FsHotWatch</PackageProjectUrl>
    <PackageTags>fsharp;test-impact-analysis;test-pruning;incremental-testing;plugin</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Allow tests to access internal members -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FsHotWatch.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- The CLI's solution-scope check shares the xUnit MTP package-id patterns -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FsHotWatch.Cli</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Flakiness.fs" />
    <Compile Include="FileFreshness.fs" />
    <Compile Include="IndexedAnalysis.fs" />
    <Compile Include="PendingVerification.fs" />
    <Compile Include="FullSuiteBaseline.fs" />
    <Compile Include="WholeProjectEvidence.fs" />
    <Compile Include="CoverageNotIngested.fs" />
    <Compile Include="DependencyFanout.fs" />
    <Compile Include="ArtifactFreshness.fs" />
    <Compile Include="StaleArtifactPreflight.fs" />
    <Compile Include="ImpactDbPool.fs" />
    <Compile Include="Traces.fs" />
    <Compile Include="ScopeVocabulary.fs" />
    <Compile Include="TestMode.fs" />
    <Compile Include="TraceRun.fs" />
    <Compile Include="TimeoutMarker.fs" />
    <Compile Include="Starvation.fs" />
    <Compile Include="Profile.fs" />
    <Compile Include="Insights.fs" />
    <Compile Include="SelectionPrice.fs" />
    <Compile Include="CheckSkip.fs" />
    <Compile Include="TestEvidenceRun.fs" />
    <Compile Include="GroupSchedule.fs" />
    <Compile Include="TestPrunePlugin.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FsHotWatch/FsHotWatch.fsproj" />
    <!-- TestPrune lives in this repository (AUTOMATION-1367), so the plugin builds against its
         source rather than a released package: a cross-cutting fix is one commit and one CI run,
         with no release-then-pin step between them. Packed, these become package dependencies
         at the referenced projects' own versions. TestPrune.Trace brings the weaver, shadow
         bin, ingestion and trace store (`tests.traces`) and, transitively, the recorder. -->
    <ProjectReference Include="../TestPrune.Core/TestPrune.Core.fsproj" />
    <ProjectReference Include="../TestPrune.Trace/TestPrune.Trace.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
