<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>fshw</ToolCommandName>
        <PackageId>FsHotWatch.Cli</PackageId>
        <Version>0.14.0-alpha.29</Version>
        <Authors>Michael Glass</Authors>
        <Description>CLI for FsHotWatch — F# file watcher daemon</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/michaelglass/FsHotWatch</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/michaelglass/FsHotWatch</PackageProjectUrl>
        <PackageTags>fsharp;cli;file-watcher;daemon;dotnet-tool</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <!-- Daemon holds FCS caches; without this the GC retains GBs of collectable churn.
             Benchmarked ~25-40% footprint reduction at no throughput cost (2026-06).
             Users can override per-process with the DOTNET_GCConserveMemory env var. -->
        <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
    </ItemGroup>

    <!-- Allow tests to access internal members (mirrors src/FsHotWatch) -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>FsHotWatch.Tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>FsHotWatch.IntegrationTests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="SolutionScope.fs" />
        <Compile Include="DaemonConfig.fs" />
        <Compile Include="InitConfig.fs" />
        <Compile Include="RunOnceOutput.fs" />
        <Compile Include="IpcParsing.fs" />
        <Compile Include="CheckVerdict.fs" />
        <Compile Include="Verdict.fs" />
        <Compile Include="ProgressRenderer.fs" />
        <Compile Include="IpcOutput.fs" />
        <Compile Include="SourceRef.fs" />
        <Compile Include="RunOnceCheck.fs" />
        <Compile Include="DeadCode.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../FsHotWatch/FsHotWatch.fsproj" />
        <ProjectReference Include="../FsHotWatch.Build/FsHotWatch.Build.fsproj" />
        <ProjectReference Include="../FsHotWatch.Lint/FsHotWatch.Lint.fsproj" />
        <ProjectReference Include="../FsHotWatch.Fantomas/FsHotWatch.Fantomas.fsproj" />
        <ProjectReference Include="../FsHotWatch.Analyzers/FsHotWatch.Analyzers.fsproj" />
        <ProjectReference Include="../FsHotWatch.TestPrune/FsHotWatch.TestPrune.fsproj" />
        <ProjectReference Include="../FsHotWatch.FileCommand/FsHotWatch.FileCommand.fsproj" />
        <ProjectReference Include="../FsHotWatch.Coverage/FsHotWatch.Coverage.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
        <PackageReference Include="CommandTree" Version="0.8.1" />
        <PackageReference Include="TestPrune.Falco" Version="3.1.3" />
        <PackageReference Include="TestPrune.Sql" Version="0.1.0" />
        <PackageReference Include="TestPrune.SqlHydra" Version="0.1.0" />
        <!-- Direct refs for `fshw dead-code`: TestPrune.Core's DeadCode analysis +
             SymbolStore (transitive via FsHotWatch.TestPrune, made explicit for
             compile-time access), and Microsoft.Data.Sqlite to probe the DB's
             schema version before opening (so we never recreate the daemon's DB). -->
        <!-- Keep in lockstep with FsHotWatch.TestPrune's TestPrune.Core pin so
             NuGet doesn't see a downgrade. -->
        <PackageReference Include="TestPrune.Core" Version="8.1.5" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
                <PackageReference Update="FSharp.Core" Version="10.1.*" />
    </ItemGroup>
</Project>
