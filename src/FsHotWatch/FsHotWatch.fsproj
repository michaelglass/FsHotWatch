<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <!-- WarnOn is shared by every src/ package: see src/Directory.Build.props. -->

    <!-- Suppress version mismatch warnings -->

    <!-- Package metadata -->
    <PackageId>FsHotWatch</PackageId>
    <Version>0.10.0-alpha.115</Version>
    <Authors>Michael Glass</Authors>
    <Description>F# file watcher daemon — keeps FSharpChecker warm for instant re-analysis</Description>
    <PackageTags>fsharp;file-watcher;fsharp-compiler-service;incremental;analysis</PackageTags>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/michaelglass/FsHotWatch</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/michaelglass/FsHotWatch</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Allow tests to access internal members.
       FsHotWatch.TestPrune is here for the evidence minting: `EarnedEvidence`,
       `AnalysisEvidence` and their `I*State` interfaces stay INTERNAL so no third-party
       plugin can mint a receipt from a completion record it made up, and the one
       first-party plugin whose folds do mint them needs the friend access. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FsHotWatch.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FsHotWatch.IntegrationTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FsHotWatch.Cli</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FsHotWatch.TestPrune</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FsHotWatch.Build</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Locking.fs" />
    <Compile Include="DrainedTimer.fs" />
    <Compile Include="Logging.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="SessionScope.fs" />
    <Compile Include="HostClock.fs" />
    <Compile Include="OperationWatchdog.fs" />
<Compile Include="Lifecycle.fs" />
    <Compile Include="ProjectModel.fs" />
    <Compile Include="ProjectModelWire.fs" />
    <Compile Include="PathFrame.fs" />
    <Compile Include="FcsSuppression.fs" />
    <Compile Include="Events.fs" />
    <Compile Include="CachePathIdentity.fs" />
    <Compile Include="PathFilter.fs" />
    <Compile Include="RepoFiles.fs" />
    <Compile Include="SafeWalk.fs" />
    <Compile Include="ProcessRegistry.fs" />
    <Compile Include="DeadlineWorkers.fs" />
    <Compile Include="SpawnHelper.fs" />
    <Compile Include="InProcessProcessTable.fs" />
    <Compile Include="ProcessHelper.fs" />
    <Compile Include="FsHwPaths.fs" />
    <Compile Include="Restart.fs" />
    <Compile Include="PidFile.fs" />
    <Compile Include="ContentHash.fs" />
    <Compile Include="SnapshotEpoch.fs" />
    <Compile Include="DaemonIdentity.fs" />
    <Compile Include="MacAttrList.fs" />
    <Compile Include="StoredName.fs" />
    <Compile Include="FileStamp.fs" />
    <Compile Include="Interruption.fs" />
    <Compile Include="RepositoryIdentity.fs" />
    <Compile Include="PathToken.fs" />
    <Compile Include="AttachHandshake.fs" />
    <Compile Include="WatchRouter.fs" />
    <Compile Include="CheckCache.fs" />
    <Compile Include="CacheInputs.fs" />
    <Compile Include="ApiSignature.fs" />
    <Compile Include="StructureFiles.fs" />
    <Compile Include="InMemoryCheckCache.fs" />
    <Compile Include="CheckCacheTally.fs" />
    <Compile Include="ScanProgress.fs" />
    <Compile Include="StringHelpers.fs" />
    <Compile Include="ErrorLedger.fs" />
    <Compile Include="FcsDiagnosticFilter.fs" />
    <Compile Include="FileErrorReporter.fs" />
    <Compile Include="Plugin.fs" />
    <Compile Include="TaskCache.fs" />
    <Compile Include="FileTaskCache.fs" />
    <Compile Include="DotnetToolchain.fs" />
    <Compile Include="SdkChoice.fs" />
    <Compile Include="RepoIdentity.fs" />
    <Compile Include="NamespaceReclaim.fs" />
    <Compile Include="CacheResidency.fs" />
    <Compile Include="PluginWorkOwner.fs" />
    <Compile Include="RunClaim.fs" />
    <Compile Include="SupervisedWork.fs" />
    <Compile Include="DebouncedWork.fs" />
    <Compile Include="WorkScheduler.fs" />
    <Compile Include="LiveResults.fs" />
    <Compile Include="PluginFramework.fs" />
    <Compile Include="DaemonPhases.fs" />
    <Compile Include="PluginActivity.fs" />
    <Compile Include="MacFsEvents.fs" />
    <Compile Include="ContentDedup.fs" />
    <Compile Include="Discovery.fs" />
    <Compile Include="Ctrf.fs" />
    <Compile Include="RunLog.fs" />
    <Compile Include="VerdictInputs.fs" />
    <Compile Include="ConfiguredTestRoots.fs" />
    <Compile Include="TreeHash.fs" />
    <Compile Include="TestEvidenceKey.fs" />
    <Compile Include="TestEvidenceStore.fs" />
    <Compile Include="OutcomeStore.fs" />
    <Compile Include="TestFailureClearance.fs" />
    <Compile Include="MetadataRows.fs" />
    <Compile Include="OutputIdentity.fs" />
    <Compile Include="CheckRecords.fs" />
    <Compile Include="OptionsRecords.fs" />
    <Compile Include="RecordAudit.fs" />
    <Compile Include="OptionsInputs.fs" />
    <Compile Include="OptionsPortable.fs" />
    <Compile Include="Watcher.fs" />
    <Compile Include="CommandPreprocessor.fs" />
    <Compile Include="SharedWatchPool.fs" />
    <Compile Include="CheckerPartitions.fs" />
    <Compile Include="FcsBootstraps.fs" />
    <Compile Include="CanonicalProjects.fs" />
    <Compile Include="DaemonHosting.fs" />
    <Compile Include="PluginHost.fs" />
    <Compile Include="ProjectGraph.fs" />
    <Compile Include="OutputCopyFreshness.fs" />
    <Compile Include="RefAssemblyFreshness.fs" />
    <Compile Include="DepsFreshness.fs" />
    <Compile Include="ProjectSnapshots.fs" />
    <Compile Include="FrameExclusions.fs" />
    <Compile Include="ImportStore.fs" />
    <Compile Include="SessionFrames.fs" />
    <Compile Include="CheckPipeline.fs" />
    <Compile Include="SuspectRecheck.fs" />
    <Compile Include="DaemonStop.fs" />
    <Compile Include="Ipc.fs" />
    <Compile Include="RepositoryIpc.fs" />
    <Compile Include="ScanActivity.fs" />
    <Compile Include="IdleExit.fs" />
    <Compile Include="VanishedRoot.fs" />
    <Compile Include="Heartbeat.fs" />
    <Compile Include="PluginWedge.fs" />
    <Compile Include="HookStep.fs" />
    <Compile Include="ScanMetrics.fs" />
    <Compile Include="Daemon.fs" />
    <Compile Include="SessionRegistry.fs" />
    <Compile Include="HostLifecycle.fs" />
    <Compile Include="RepositoryHost.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- FsHotWatch.Core is not a package (AUTOMATION-1668). PrivateAssets keeps it out of this
         nupkg's dependencies; `PackFsHotWatchCore` below carries its assembly in lib/. This
         package carries it, once, because every other FsHotWatch package depends on this one;
         the re-architecture moves the correctness core (L0-L2) into it (AUTOMATION-1695). -->
    <ProjectReference Include="../FsHotWatch.Core/FsHotWatch.Core.fsproj" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackFsHotWatchCore</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <!-- Packs FsHotWatch.Core's built assembly beside this one, in lib/. It asks Core for its output
       path (GetTargetPath builds nothing) instead of resolving references, which would build and
       breaks a no-build pack with NETSDK1085 (the package-floor check in mise run ci). -->
  <Target Name="PackFsHotWatchCore">
    <MSBuild Projects="../FsHotWatch.Core/FsHotWatch.Core.fsproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_FsHotWatchCoreAssembly" />
    </MSBuild>
    <ItemGroup>
      <BuildOutputInPackage Include="@(_FsHotWatchCoreAssembly)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Ignore" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FSharp.Data.Adaptive" />
    <PackageReference Include="StreamJsonRpc" />
    <!-- StreamJsonRpc 2.25.29 (the latest) floors MessagePack at 2.5.302, which GHSA-qhrr-8q5h-9q3h
         affects; 2.5.303 is the patched 2.x release on the line StreamJsonRpc targets. Drop this pin
         once a StreamJsonRpc release floors MessagePack at or above 2.5.303. -->
    <PackageReference Include="MessagePack" />
    <PackageReference Include="FSharp.Compiler.Service" />
    <PackageReference Include="Ionide.ProjInfo" />
    <PackageReference Include="Ionide.ProjInfo.FCS" />
  </ItemGroup>

  <!-- MSBuild's evaluation API, for `OptionsInputs` (AUTOMATION-1372). Compiled against the
       building SDK's own assemblies and never copied: at run time MSBuild is the SDK's, which
       Ionide.ProjInfo locates (`Init.init`), exactly as for Ionide's own use of it. Not a
       package reference: a package would bring app-local copies of MSBuild's dependencies,
       which is the downgrade `scripts/check-msbuild-deps.fsx` guards against. -->
  <ItemGroup>
    <Reference Include="Microsoft.Build">
      <HintPath>$(MSBuildBinPath)/Microsoft.Build.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Build.Framework">
      <HintPath>$(MSBuildBinPath)/Microsoft.Build.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
